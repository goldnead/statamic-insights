{
    "name": "goldnead/statamic-insights",
    "description": "Reports over what the addon family already records: revenue, campaigns, products.",
    "type": "statamic-addon",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Goldnead\\StatamicInsights\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goldnead\\StatamicInsights\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "suggest": {
        "goldnead/statamic-payments": "The source of every number this addon reports. Without it the revenue screen has nothing to show.",
        "goldnead/statamic-leadhub": "Adds the buyer behind a number: lifetime revenue per contact."
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Insights",
            "description": "Revenue, campaigns and products — read from what the family already records.",
            "developer": "Adrian Goldner"
        },
        "laravel": {
            "providers": [
                "Goldnead\\StatamicInsights\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "php -d memory_limit=-1 ./vendor/bin/phpunit",
        "lint": "./vendor/bin/pint --test",
        "fix": "./vendor/bin/pint",
        "analyse": "./vendor/bin/phpstan analyse"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
